# Copy to server/.env and fill in real values locally. Never commit .env.
# Loaded by dotenv only when the server is started directly (npm start).
# Variables already set in your shell take precedence over this file.
PORT=3000
HOST=127.0.0.1

# Required for AI analysis. Without both, POST /analyze returns 503.
# Use a key from a billing-enabled project: under Google's Gemini API terms, free-tier
# prompts may be used to improve Google products and must not contain personal data.
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.1-flash-lite
