{
  "manifest_version": 3,
  "name": "PhishGuard",
  "version": "1.0.0",
  "description": "Flags suspicious Gmail messages and explains common phishing signals.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://mail.google.com/*"],
  "optional_host_permissions": ["http://127.0.0.1:3000/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Analyze this email",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["detector.js", "context.js", "analysis.js", "overlay.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["prototype/PhishGuardLogo.png"],
      "matches": ["https://mail.google.com/*"]
    }
  ]
}
